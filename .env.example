# Copy this file to .env.local for local development, and set the same
# values in Vercel Project Settings -> Environment Variables for production.
# NEVER commit .env.local or real secrets — .gitignore already excludes it.

# ---- Firebase (client, public by design) ----
# From Firebase Console -> Project settings -> General -> Your apps -> Web app.
# These are NOT secret (Firebase web config is meant to be public; security
# comes from Firestore rules), but there's nothing to bake in until you've
# created the project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server-only secret) ----
# From Firebase Console -> Project settings -> Service accounts -> Generate
# new private key. Keep FIREBASE_PROJECT_ID in sync with the value above.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the downloaded JSON. Keep the \n sequences
# literal (do not convert to real newlines in this file) — the app converts
# them at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Google Maps Platform (server-only secret) ----
# One API key with Places API (New), Routes API, and Geocoding API all
# enabled. Restrict it to those three APIs in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# ---- Google Gemini (server-only secret) ----
# From Google AI Studio (aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional model override:
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Office location ----
# Preferred: exact coordinates (fastest, no geocode call at runtime).
OFFICE_LAT=40.7541
OFFICE_LNG=-74.0021
# Human-readable address, shown in the UI and used to geocode if
# OFFICE_LAT/OFFICE_LNG are not set.
OFFICE_ADDRESS="10 Hudson Yards, New York, NY 10001"
