# Copy this file to .env.local for local development, and set the same
# values in Vercel Project Settings -> Environment Variables for production.
# NEVER commit .env.local or real secrets — .gitignore already excludes it.

# ---- Firebase (client, public by design) ----
# From Firebase Console -> Project settings -> General -> Your apps -> Web app.
# These are NOT secret (Firebase web config is meant to be public; security
# comes from Firestore rules), but there's nothing to bake in until you've
# created the project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server-only secret) ----
# From Firebase Console -> Project settings -> Service accounts -> Generate
# new private key. Keep FIREBASE_PROJECT_ID in sync with the value above.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the downloaded JSON. Keep the \n sequences
# literal (do not convert to real newlines in this file) — the app converts
# them at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Google Places (server-only secret) ----
# One API key with ONLY Places API (New) enabled — restrict it to that one
# API in Google Cloud Console. Deliberately the only Google Maps Platform
# API this app uses (walking time and office geocoding both use free,
# no-billing-account alternatives instead — see below), so this is the only
# thing here that needs a Google Cloud billing account attached at all.
GOOGLE_MAPS_API_KEY=

# ---- OpenRouteService (server-only secret, free tier) ----
# Real walking-route times from the office. Free forever (2,000 requests/day,
# no credit card): sign up at openrouteservice.org/dev/#/signup and copy the
# API key from your dashboard.
OPENROUTESERVICE_API_KEY=

# ---- Google Gemini (server-only secret) ----
# From Google AI Studio (aistudio.google.com/apikey) — free tier, no billing
# account required for this app's low volume.
GEMINI_API_KEY=
# Optional model override:
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Office location ----
# Preferred: exact coordinates (fastest, no geocode call at runtime, and
# guarantees the free OpenStreetMap Nominatim geocoder below is never used).
OFFICE_LAT=40.7541
OFFICE_LNG=-74.0021
# Human-readable address, shown in the UI and used to geocode (via free
# OpenStreetMap Nominatim, no API key, cached in Firestore after the first
# lookup) if OFFICE_LAT/OFFICE_LNG are not set.
OFFICE_ADDRESS="10 Hudson Yards, New York, NY 10001"
